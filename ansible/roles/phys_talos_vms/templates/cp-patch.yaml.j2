# ANSIBLE MANAGED — talu phys Talos control-plane patch: shared VIP = the Kubernetes API endpoint.
machine:
  network:
    interfaces:
      - deviceSelector:
          driver: virtio_net
        dhcp: true
        vip:
          ip: {{ talos_vip }}
cluster:
  # Expose control-plane component metrics for Prometheus. Talos binds these to localhost by default, so
  # kube-prometheus-stack's kubeEtcd/kubeScheduler/kubeControllerManager scrapes see nothing. etcd gets a
  # dedicated plain-HTTP metrics-only listener on :2381 (no client cert needed — metrics only); the
  # scheduler/controller-manager expose their existing HTTPS metrics (:10259 / :10257) on all interfaces.
  # Consumed by components/platform/monitoring/controlplane-scrape.yaml (Service+Endpoints+ServiceMonitor).
  etcd:
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
  scheduler:
    extraArgs:
      bind-address: 0.0.0.0
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
