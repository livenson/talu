# ANSIBLE MANAGED — the STATIC half of the phys Pomerium config, consumed by route-sync (which owns the
# live pomerium-config, gotcha #40). route-sync reads key `base.yaml`, substitutes `__DOMAIN__` with the
# talu-platform domain, appends the dynamic per-Service routes (ssh://, dashboards, landing), and writes
# the result to pomerium-config every 2 min. Keep this in lockstep with pomerium.yaml.j2's config.yaml —
# the ansible role writes an initial pomerium-config from that template; route-sync then takes ownership.
# Route items sit at 2-space indent (sub-keys 4) so route-sync's appended items line up.
apiVersion: v1
kind: ConfigMap
metadata:
  name: pomerium-base
  namespace: pomerium
  labels: { app.kubernetes.io/part-of: talu }
data:
  base.yaml: |
    autocert: true
    autocert_dir: /data/autocert
    metrics_address: ":9902"
    http_redirect_addr: ":80"
    ssh_address: ":2222"
    ssh_user_ca_key_file: /ssh/user_ca
    ssh_host_key_files: [/ssh/host_ed25519, /ssh/host_rsa, /ssh/host_ecdsa]
    authenticate_service_url: https://authenticate.__DOMAIN__
    idp_provider: oidc
    idp_provider_url: https://id.__DOMAIN__/dex
    idp_client_id: pomerium
    idp_client_secret: {{ pomerium_idp_client_secret }}
    idp_scopes: [openid, profile, email]
    routes:
      - from: https://id.__DOMAIN__
        to: http://dex.identity.svc:5556
        allow_public_unauthenticated_access: true
        preserve_host_header: true
      - from: https://__DOMAIN__
        to: http://talu-portal.pomerium.svc:80
        allow_public_unauthenticated_access: true
      - from: https://vms.__DOMAIN__
        to: http://kubevirt-manager.kubevirt-manager.svc:8080
        allowed_users: [{{ dex_user_email }}]
        allow_websockets: true
      - from: https://clusters.__DOMAIN__
        to: http://kamaji-console.kamaji-system.svc:80
        allowed_users: [{{ dex_user_email }}]
        allow_websockets: true
      - from: https://perses.__DOMAIN__
        to: http://talu.monitoring.svc:8080
        allowed_users: [{{ dex_user_email }}]
        allow_websockets: true
      - from: https://hubble.__DOMAIN__
        to: http://hubble-ui.kube-system.svc:80
        allowed_users: [{{ dex_user_email }}]
        allow_websockets: true
