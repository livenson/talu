# ANSIBLE MANAGED — talu roles/phys_registry_mirror. Podman Quadlet.
# Pull-through cache for {{ item.remote }} → served on :{{ item.port }}.
[Unit]
Description=Talu pull-through registry cache ({{ item.name }} → {{ item.remote }})
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=registry-{{ item.name }}
Image={{ mirror_registry_image }}
PublishPort={{ mirror_bind_ip }}:{{ item.port }}:5000
Volume={{ mirror_data_root }}/{{ item.name }}:/var/lib/registry:Z
Environment=REGISTRY_PROXY_REMOTEURL={{ item.remote }}
Environment=REGISTRY_STORAGE_DELETE_ENABLED=true
Environment=REGISTRY_HTTP_ADDR=0.0.0.0:5000
# Keep the cache from growing without bound: registry:2 has no TTL GC, so rely on disk headroom
# (407 GB free) + `registry garbage-collect` if needed. Documented, not automated here.

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target default.target
